PORT=8000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/profligate
# or MONGO_URI for cloud atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/profligate

CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret
REFRESH_TOKEN_EXPIRY=7d

# SendGrid Email Service
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@profligate.app

# AI Provider Configuration (Version 1.1)
AI_PROVIDER=openai
AI_API_KEY=replace_with_your_api_key
AI_MODEL=gpt-4o-mini

